# Copy to .env (git ignores it) and fill in what you use. Everything here is optional:
# you can also connect GitHub and paste keys in the game under Settings -> Agents & keys,
# which stores them in ~/.openworld/config.json (readable by your user only).
# Values set here win over the ones saved in Settings.

# ---- GitHub: your repos become the buildings ----
# Or run `gh auth login` once. A classic token needs the `repo` scope (private repos, opening PRs);
# a fine-grained token needs Contents + Pull requests (read/write) and Metadata (read).
# GITHUB_TOKEN=

# ---- Conversations and coding agents ----
# Claude (Anthropic). Also used by Claude Code; or just run `claude` once and sign in.
# ANTHROPIC_API_KEY=
# ChatGPT / OpenAI. Also used by Codex; or run `codex login` and sign in with your ChatGPT account.
# OPENAI_API_KEY=
# Google Gemini. Also used by Gemini CLI; or run `gemini` once and sign in.
# GEMINI_API_KEY=

# Any OpenAI-compatible server for conversations: OpenRouter, Groq, Together, Mistral, DeepSeek, xAI,
# or a model on this computer (Ollama, LM Studio, llama.cpp: no key needed).
# OPENWORLD_LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENWORLD_LLM_API_KEY=
# OPENWORLD_LLM_MODEL=
# Examples:
#   Ollama:    OPENWORLD_LLM_BASE_URL=http://localhost:11434/v1  OPENWORLD_LLM_MODEL=llama3.2
#   LM Studio: OPENWORLD_LLM_BASE_URL=http://localhost:1234/v1
#   Groq:      OPENWORLD_LLM_BASE_URL=https://api.groq.com/openai/v1

# Force a chat model by name for whichever provider is active (e.g. claude-sonnet-5-5).
# OPENWORLD_MODEL=

# ---- Server ----
# PORT=4317                    # HTTP port (Vite dev server proxies to it)
# HTTPS_PORT=4318              # HTTPS for VR headsets, with OPENWORLD_HTTPS=1
# OPENWORLD_HTTPS=1
# OPENWORLD_HOME=~/.openworld  # where config, caches, worktrees and logs live
# OPENWORLD_TILE_CACHE_MB=3000 # map tile cache cap

# ---- Testing ----
# OPENWORLD_FAKE_AGENTS=1      # scripted agents instead of real CLIs
# OPENWORLD_DRY_PR=1           # never open real pull requests
# OPENWORLD_DRY_GITHUB=1       # no GitHub writes at all
