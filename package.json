{
  "name": "openworld",
  "version": "1.0.0",
  "description": "An open-world city where every GitHub repo is a building and AI agents work inside.",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite --config client/vite.config.ts\"",
    "server": "tsx server/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "open": "^11.0.4",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "type": "module",
  "bin": {
    "openworld": "bin/openworld.js"
  }
}
