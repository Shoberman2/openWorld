{
  "name": "openworld",
  "version": "1.0.0",
  "description": "Your GitHub as an open world: walk the real planet, every repo is a building, and AI coding agents (Claude, ChatGPT/Codex, Gemini or any model) work inside.",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --config client/vite.config.ts\"",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/fetch-models.mjs",
    "start": "npm run build && NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "vr": "npm run build && NODE_ENV=production OPENWORLD_HTTPS=1 tsx --env-file-if-exists=.env server/index.ts"
  },
  "keywords": [
    "open-world",
    "threejs",
    "openstreetmap",
    "github",
    "ai-agents",
    "claude",
    "chatgpt",
    "codex",
    "gemini",
    "ollama",
    "webxr"
  ],
  "author": "OpenWorld contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.3",
    "express": "^5.3.0",
    "open": "^11.0.4",
    "pbf": "^4.0.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "type": "module",
  "bin": {
    "openworld": "bin/openworld.js"
  }
}
